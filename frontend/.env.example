# ==============================================================================
# ORCA FRONTEND CONFIGURATION & OPTIONAL MAP API KEYS
# ==============================================================================

# Backend API URL (Default: http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Physical Hardware Ingestion Endpoint (Default placeholder: http://localhost:5000; or LAN IP like http://10.169.191.69:5000)
VITE_HARDWARE_API_URL=http://localhost:5000

# OPTIONAL: Mapbox Access Token
# If you want custom Mapbox Satellite or Navigation styles, get a free token at:
# https://account.mapbox.com/ (Free tier: 50,000 monthly map loads)
# VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXJuYW1lIi...

# OPTIONAL: CARTO API Key
# If you want authenticated CARTO Dark Matter vector tiles, get a key at:
# https://carto.com/developers/
# VITE_CARTO_API_KEY=your_carto_api_key_here

# NOTE: The default Ocean Bathymetry & Satellite maps use ESRI World Ocean & Imagery,
# which are 100% FREE and require NO API KEY at all!
