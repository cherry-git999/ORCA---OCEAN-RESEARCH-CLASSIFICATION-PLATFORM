# ==============================================================================
# ORCA Backend Configuration (.env.example)
# Copy to .env to customize local server configuration
# ==============================================================================

# Server Network Binding
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Model Directory Override (Optional)
# Defaults to repository-local 'models/' directory containing:
#   models/pipeline/best.pt
#   models/human/best.pt
#   models/hardware/best.pt
# ORCA_MODEL_DIR=./models

# CORS Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
